# Copy this file to .env.local. Restart Vite after changing it.
# Local Laravel address; this value is used only by the Vite proxy.
BACKEND_URL=http://127.0.0.1:8000

# Public frontend URL printed by ngrok or cloudflared (no trailing path).
# Leave empty for local development. Use the exact URL, not a wildcard domain.
TUNNEL_URL=
